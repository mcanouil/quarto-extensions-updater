{
  "name": "Quarto Extensions Updater",
  "short_name": "Extensions Updater",
  "description": "Keep the Quarto extensions of a repository up to date, the way Dependabot keeps dependencies up to date.",
  "lang": "en-GB",
  "start_url": "./",
  "scope": "./",
  "display": "browser",
  "theme_color": "#0E1618",
  "background_color": "#F4F8F8",
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
