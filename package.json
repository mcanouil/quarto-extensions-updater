{
	"name": "quarto-extensions-updater",
	"version": "2.2.1",
	"description": "GitHub Action to automatically update Quarto extensions similar to Dependabot",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
		"format": "prettier --write '**/*.ts'",
		"format-check": "prettier --check '**/*.ts'",
		"lint": "eslint src/**/*.ts",
		"package": "npm run build",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest",
		"all": "npm run format && npm run lint && npm run package"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mcanouil/quarto-extensions-updater.git"
	},
	"keywords": [
		"github-action",
		"quarto",
		"extensions",
		"dependabot",
		"updates"
	],
	"author": "Mickaël Canouil",
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0"
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@quarto-wizard/core": "https://github.com/mcanouil/quarto-wizard/releases/download/3.2.0/quarto-wizard-core-3.2.0.tgz",
		"js-yaml": "^5.4.1",
		"semver": "^7.8.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.4.0",
		"@types/semver": "^7.8.0",
		"@vercel/ncc": "^0.45.0",
		"eslint": "^10.9.1",
		"jest": "^30.5.0",
		"prettier": "^3.9.6",
		"ts-jest": "^29.4.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0"
	}
}
